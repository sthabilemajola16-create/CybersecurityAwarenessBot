<Application x:Class="CybersecurityAwarenessBot.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#00B4D8"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#0077B6"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#90E0EF"/>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#0A1628"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#132238"/>
        <SolidColorBrush x:Key="BotBubbleBrush" Color="#1B3A57"/>
        <SolidColorBrush x:Key="UserBubbleBrush" Color="#264653"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#2ECC71"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#F39C12"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#E74C3C"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E8F4F8"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8BA4B8"/>
    </Application.Resources>
</Application>
