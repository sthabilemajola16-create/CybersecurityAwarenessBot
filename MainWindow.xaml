<Window x:Class="CybersecurityAwarenessBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot"
        Height="720" Width="960"
        MinHeight="600" MinWidth="800"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with ASCII art from Task 1 -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="CYBERSECURITY AWARENESS BOT"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="Stay alert. Stay secure. Stay informed."
                               FontSize="13" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,8"/>
                    <TextBox x:Name="AsciiArtBlock"
                             IsReadOnly="True" BorderThickness="0"
                             Background="Transparent"
                             Foreground="{StaticResource MutedBrush}"
                             FontFamily="Consolas" FontSize="9"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Disabled"
                             HorizontalScrollBarVisibility="Auto"
                             Text="   ____      _                          _ _         _             &#x0a; / ___|   _| |__   ___ _ __ ___   ___ | (_)_ __   | |__   ___   _&#x0a;| |  | | | | '_ \ / _ \ '__/ __| / _ \| | | '_ \  | '_ \ / _ \ / |&#x0a;| |__| |_| | |_) |  __/ |  \__ \| (_) | | | | | | | |_) | (_) || |&#x0a; \____\__, |_.__/ \___|_|  |___(_)___/|_|_|_| |_| |_.__/ \___(_)_|&#x0a;      |___/                                                        "/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock x:Name="UserNameLabel" Text="Guest"
                               FontSize="14" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Right"/>
                    <Button x:Name="PlayGreetingButton" Content="Play Greeting"
                            Margin="0,8,0,0" Padding="12,6"
                            Background="{StaticResource SecondaryBrush}"
                            Foreground="{StaticResource TextBrush}"
                            BorderThickness="0" Cursor="Hand"
                            Click="PlayGreetingButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Chat area -->
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="8">
            <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ChatPanel" Margin="4"/>
            </ScrollViewer>
        </Border>

        <!-- Input area -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox"
                     Grid.Column="0"
                     MinHeight="40" Padding="12,10"
                     FontSize="14"
                     Background="#1A2D45"
                     Foreground="{StaticResource TextBrush}"
                     CaretBrush="{StaticResource AccentBrush}"
                     BorderBrush="{StaticResource SecondaryBrush}"
                     BorderThickness="1"
                     VerticalContentAlignment="Center"
                     KeyDown="InputBox_KeyDown"/>
            <Button x:Name="SendButton" Grid.Column="1"
                    Content="Send" MinWidth="100" Margin="8,0,0,0"
                    Padding="16,10" FontSize="14" FontWeight="SemiBold"
                    Background="{StaticResource PrimaryBrush}"
                    Foreground="#0A1628"
                    BorderThickness="0" Cursor="Hand"
                    Click="SendButton_Click"/>
        </Grid>
    </Grid>
</Window>
